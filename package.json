{
  "name": "cardafin",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Cardano wallet manager service layer: wallets, balances, ADA and native-token transfers, minting.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts' 'web/**/*.test.mjs'",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "cli": "node --experimental-strip-types --env-file-if-exists=.env src/cli.ts",
    "serve": "node --experimental-strip-types --env-file-if-exists=.env src/http/server.ts",
    "console": "node --experimental-strip-types --env-file-if-exists=.env src/http/dev-server.ts",
    "console:probe": "node --experimental-strip-types src/http/probe.ts",
    "freeze": "node scripts/freeze-ports.mjs",
    "new-capability": "node scripts/new-capability.mjs"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "0.8.9",
    "@blockfrost/blockfrost-js": "6.2.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
