# Preview | Preprod | Mainnet. Default Preview. Mainnet is real money.
CARDAFIN_NETWORK=Preview
# From https://blockfrost.io — must match the network above
BLOCKFROST_PROJECT_ID=YOUR_BLOCKFROST_KEY_HERE
# 24-word master mnemonic. v1 custody = this env var on the host. See README.
# The value below is the public BIP-39 test vector — a throwaway. Replace it.
CARDAFIN_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon art"
# Mainnet is refused unless this equals I_UNDERSTAND_REAL_FUNDS
CARDAFIN_MAINNET_CONFIRM=
CARDAFIN_HTTP_PORT=8787
# Comma-separated bearer tokens accepted by the HTTP surface
CARDAFIN_API_KEYS=
